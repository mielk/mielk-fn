{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "ES2020",
		"module": "ESNext",
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["jest"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
